# Hackerly configuration. Copy to .env and change what you need.
# Everything is optional except SESSION_SECRET in production.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
BASE_URL=http://localhost:8080

# --- data -------------------------------------------------------------------
# Local mode: one SQLite file. This is the whole database.
DATA_DIR=./data
SQLITE_FILE=./data/hackerly.db
# Global mode on Google Cloud: DB_DRIVER=firestore (see ARCHITECTURE.md)
DB_DRIVER=sqlite

# --- sessions and security --------------------------------------------------
# Required in production: openssl rand -hex 32
# SESSION_SECRET=
SESSION_COOKIE=hkl_session
SESSION_TTL_DAYS=30
SESSION_SECURE=false          # true behind HTTPS
CSRF_PROTECT=true
TRUST_PROXY=false
RATE_LIMIT=true
MAX_BODY_BYTES=524288

# --- seeding ----------------------------------------------------------------
SEED_ON_BOOT=true
SEED_DEMO=true
SEED_FIXTURES=true
FIXTURES_FILE=./fixtures.json
# Deterministic acceptance accounts for the DOGFOOD checker. Off in production.
ACCEPTANCE_ACCOUNTS=true

# --- mail -------------------------------------------------------------------
# log  -> invitations are written to data/outbox and shown in the host UI
# smtp -> real delivery over SMTP
MAIL_MODE=log
MAIL_FROM=Hackerly <no-reply@hackerly.local>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- optional Firebase (Global mode) ----------------------------------------
# Leave unset for a fully self-hosted install. Nothing here is required.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_WEB_API_KEY=          # enables the "Continue with Google" button
# FIREBASE_AUTH_DOMAIN=

# --- observability ----------------------------------------------------------
LOG_LEVEL=info
LOG_JSON=false
CACHE_ENABLED=true
CACHE_TTL=30
