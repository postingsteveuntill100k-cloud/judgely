{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/auth/config",
        "destination": "/api/auth/config.json"
      },
      {
        "source": "/api/auth/me",
        "destination": "/api/auth/me.json"
      },
      {
        "source": "/api/event",
        "destination": "/api/event.json"
      },
      {
        "source": "/api/tracks",
        "destination": "/api/tracks.json"
      },
      {
        "source": "/api/projects",
        "destination": "/api/projects.json"
      },
      {
        "source": "/api/projects/:id",
        "destination": "/api/project_details/:id.json"
      },
      {
        "source": "/api/results",
        "destination": "/api/results.json"
      },
      {
        "source": "/api/organizer/overview",
        "destination": "/api/organizer/overview.json"
      },
      {
        "source": "/api/organizer/health",
        "destination": "/api/organizer/health.json"
      },
      {
        "source": "/api/organizer/projects",
        "destination": "/api/organizer/projects.json"
      },
      {
        "source": "/api/organizer/teams",
        "destination": "/api/organizer/teams.json"
      },
      {
        "source": "/api/organizer/judges",
        "destination": "/api/organizer/judges.json"
      },
      {
        "source": "/api/organizer/assignments",
        "destination": "/api/organizer/assignments.json"
      },
      {
        "source": "/api/organizer/rubric",
        "destination": "/api/organizer/rubric.json"
      },
      {
        "source": "/api/organizer/audit",
        "destination": "/api/organizer/audit.json"
      },
      {
        "source": "/api/judge/assignments",
        "destination": "/api/judge/assignments.json"
      },
      {
        "source": "/api/fixtures",
        "destination": "/fixtures.json"
      },
      {
        "source": "/projects",
        "destination": "/index.html"
      },
      {
        "source": "/login",
        "destination": "/index.html"
      },
      {
        "source": "!/api/**",
        "destination": "/index.html"
      }
    ]
  }
}
