rules_version = '2';

// Hackerly does not expose Firestore to browsers. Every read and write goes
// through the server, which holds the admin credentials and enforces roles,
// deadlines and cross-event isolation in application code.
//
// The functions runtime uses the Admin SDK, which bypasses these rules
// entirely. They exist to make that explicit: if the database is ever exposed
// to a client, the default answer is "no".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
