rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents - public read, owner write
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email != null);
    }
    
    // Hackathons and events
    match /hackathons/{eventId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{eventId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Projects and showcase
    match /projects/{projectId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default for other collections: allow read for public, write for authenticated users
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
