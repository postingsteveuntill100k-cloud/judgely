<script>
  (function() {
    var btn = document.getElementById('btn-live-test');
    var out = document.getElementById('live-test-output');
    if (!btn || !out) return;
    btn.addEventListener('click', function() {
      btn.disabled = true;
      out.textContent = 'Pinging server...';
      fetch('/healthz')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          out.innerHTML = '<span style="color:#137333;font-weight:700;">✔ HTTP 200 OK</span> — Status: ' + (d.status || 'ok') + ' (driver: ' + (d.db_driver || 'active') + ')';
          btn.disabled = false;
        })
        .catch(function(err) {
          out.innerHTML = '<span style="color:#c5221f;font-weight:700;">✖ Error:</span> ' + err.message;
          btn.disabled = false;
        });
    });
  })();
</script>
