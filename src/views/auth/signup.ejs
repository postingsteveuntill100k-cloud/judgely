<section class="auth-shell">
  <div class="auth-card">
    <div class="auth-card__head">
      <p class="eyebrow">Create an account</p>
      <h1 style="font-size:1.7rem">Start on Hackerly</h1>
      <p class="small muted">One account for participating, hosting and judging. Browsing never needs one.</p>
    </div>

    <% if (error) { %>
      <div class="notice notice--danger" role="alert" style="margin-bottom:20px">
        <strong class="notice__title">We could not create the account</strong>
        <%= error %>
      </div>
    <% } %>

    <% if (firebase && firebase.enabled && firebase.apiKey) { %>
      <button class="btn btn--ghost btn--block" type="button" data-google-signin style="margin-bottom:8px">
        <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.5l6.7-6.7C35.6 2.5 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.8 6.1C12.3 13.4 17.6 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.2-.4-4.7H24v9h12.7c-.6 3-2.3 5.5-4.9 7.2l7.6 5.9c4.4-4.1 7.1-10.1 7.1-17.4z"/><path fill="#FBBC05" d="M10.4 28.7A14.5 14.5 0 0 1 9.6 24c0-1.6.3-3.2.8-4.7l-7.8-6.1A23.9 23.9 0 0 0 0 24c0 3.9.9 7.5 2.6 10.8l7.8-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.8 2.3-8.3 2.3-6.4 0-11.7-3.9-13.6-9.4l-7.8 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
        Continue with Google
      </button>
      <div id="google-error" class="notice notice--danger tiny" style="display:none;margin-bottom:14px;padding:8px 12px;font-size:0.8rem;"></div>
      <div class="auth-divider"><span>or</span></div>
    <% } %>

    <form method="post" action="/auth/signup" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <label class="field__label" for="display_name">Your name<span class="field__req">*</span></label>
        <input class="input" id="display_name" name="display_name" value="<%= values.display_name || '' %>" required autocomplete="name" placeholder="Ada Nwosu">
        <p class="field__hint">Judges and organizers see this on your public profile.</p>
      </div>
      <div class="field">
        <label class="field__label" for="username">Username<span class="field__req">*</span></label>
        <input class="input" id="username" name="username" value="<%= values.username || '' %>" required autocomplete="username" placeholder="ada" pattern="[a-zA-Z][a-zA-Z0-9_-]{2,23}">
        <p class="field__hint">Letters, numbers, underscore and hyphen. This is your public handle.</p>
      </div>
      <div class="field">
        <label class="field__label" for="email">Email<span class="field__req">*</span></label>
        <input class="input" id="email" type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email" placeholder="you@example.com">
      </div>
      <div class="field">
        <label class="field__label" for="password">Password<span class="field__req">*</span></label>
        <input class="input" id="password" type="password" name="password" required autocomplete="new-password" minlength="10">
        <p class="field__hint">At least 10 characters, with a letter and a number.</p>
      </div>
      <button class="btn btn--primary btn--block btn--lg" type="submit">Create account</button>
    </form>

    <p class="small muted" style="margin-top:20px;text-align:center">
      Already have an account? <a href="/auth/signin?next=<%= encodeURIComponent(next) %>">Sign in</a>
    </p>
  </div>
  <% if (firebase && firebase.enabled && firebase.apiKey) { %>
    <script type="application/json" data-firebase-config><%- JSON.stringify({ apiKey: firebase.apiKey, authDomain: firebase.authDomain, projectId: firebase.projectId, dbProjectId: firebase.dbProjectId, dbApiKey: firebase.dbApiKey }) %></script>
  <% } %>
</section>
