<section class="auth-shell">
  <div class="auth-card">
    <div class="auth-card__head">
      <p class="eyebrow">Sign in</p>
      <h1 style="font-size:1.7rem">Welcome back</h1>
      <p class="small muted">Use your email address or your username.</p>
    </div>

    <% if (error) { %>
      <div class="notice notice--danger" role="alert" style="margin-bottom:20px">
        <strong class="notice__title">Could not sign you in</strong>
        <%= error %>
      </div>
    <% } %>

    <% if (invited) { %>
      <div class="notice notice--info" style="margin-bottom:20px">
        You were invited to judge. Sign in with the email address the invitation was sent to, then reopen the invitation link.
      </div>
    <% } %>

    <% if (firebase && firebase.enabled && firebase.apiKey) { %>
      <button class="btn btn--ghost btn--block" type="button" data-google-signin style="margin-bottom:8px">
        <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.5l6.7-6.7C35.6 2.5 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.8 6.1C12.3 13.4 17.6 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.2-.4-4.7H24v9h12.7c-.6 3-2.3 5.5-4.9 7.2l7.6 5.9c4.4-4.1 7.1-10.1 7.1-17.4z"/><path fill="#FBBC05" d="M10.4 28.7A14.5 14.5 0 0 1 9.6 24c0-1.6.3-3.2.8-4.7l-7.8-6.1A23.9 23.9 0 0 0 0 24c0 3.9.9 7.5 2.6 10.8l7.8-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.8 2.3-8.3 2.3-6.4 0-11.7-3.9-13.6-9.4l-7.8 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
        Continue with Google
      </button>
      <div id="google-error" class="notice notice--danger tiny" style="display:none;margin-bottom:14px;padding:8px 12px;font-size:0.8rem;"></div>
      <div class="auth-divider"><span>or sign in with password</span></div>
    <% } %>

    <form method="post" action="/auth/signin" novalidate id="signin-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <label class="field__label" for="identifier">Email or username<span class="field__req">*</span></label>
        <input class="input" id="identifier" name="identifier" value="<%= values.identifier || '' %>" required autocomplete="username" autofocus>
      </div>
      <div class="field">
        <label class="field__label" for="password">Password<span class="field__req">*</span></label>
        <input class="input" id="password" type="password" name="password" required autocomplete="current-password">
      </div>
      <button class="btn btn--primary btn--block btn--lg" type="submit">Sign in</button>
    </form>

    <div class="auth-divider" style="margin-top:20px;"><span>or quick sign-in as</span></div>
    <div style="display:flex;flex-direction:column;gap:6px;margin-top:10px;">
      <button class="btn btn--quiet btn--sm btn--block" type="button" data-fill-creds="meera@hackerly.dev" data-pass="HackerlyDemo2026" style="display:flex;justify-content:space-between;align-items:center;padding:8px 12px;">
        <span><strong>Meera Raghavan</strong> <span class="muted tiny">(Organizer)</span></span>
        <span class="tag tag--accent tiny">Organizer</span>
      </button>
      <button class="btn btn--quiet btn--sm btn--block" type="button" data-fill-creds="alex@nexuslabs.dev" data-pass="HackerlyDemo2026" style="display:flex;justify-content:space-between;align-items:center;padding:8px 12px;">
        <span><strong>Alex Rivera</strong> <span class="muted tiny">(Judge)</span></span>
        <span class="tag tag--warn tiny">Judge</span>
      </button>
      <button class="btn btn--quiet btn--sm btn--block" type="button" data-fill-creds="elena@hacktron.dev" data-pass="HackerlyDemo2026" style="display:flex;justify-content:space-between;align-items:center;padding:8px 12px;">
        <span><strong>Elena Rostova</strong> <span class="muted tiny">(Participant)</span></span>
        <span class="tag tag--live tiny">Participant</span>
      </button>
    </div>

    <p class="small muted" style="margin-top:20px;text-align:center">
      No account yet? <a href="/auth/signup?next=<%= encodeURIComponent(next) %>">Create one</a>
    </p>
  </div>
  <% if (firebase && firebase.enabled && firebase.apiKey) { %>
    <script type="application/json" data-firebase-config><%- JSON.stringify({ apiKey: firebase.apiKey, authDomain: firebase.authDomain, projectId: firebase.projectId, dbProjectId: firebase.dbProjectId, dbApiKey: firebase.dbApiKey }) %></script>
  <% } %>
</section>
