<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' · Hackerly' : 'Hackerly — find a hackathon, host your event, judge projects' %></title>
<meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Hackerly is a self-hostable platform for hackathons. Browse open events, join a team, submit a project, and let judges review it against a real rubric.' %>">
<meta name="color-scheme" content="light">
<meta property="og:title" content="<%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Hackerly' %>">
<meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Find a hackathon. Host your event. Invite your judges.' %>">
<meta property="og:type" content="website">
<link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/pages.css?v=<%= assetVersion %>">
<% if (typeof extraCss !== 'undefined' && extraCss) { %><link rel="stylesheet" href="/css/<%= extraCss %>.css?v=<%= assetVersion %>"><% } %>
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
</head>
<body class="<%= bodyClass %>">
<a class="skip-link" href="#main">Skip to content</a>
<%- include('../partials/header', { actor, nav, csrfToken }) %>
<main id="main"><%- content %></main>
<%- include('../partials/footer', { actor }) %>
<script src="/js/app.js?v=<%= assetVersion %>" defer></script>
<% if (typeof head !== 'undefined' && head) { %><%- head %><% } %>
</body>
</html>
