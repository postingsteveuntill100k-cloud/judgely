<%- include('../partials/host-head', { event, nav: hostNav, counts }) %>

<section class="section section--tight">
  <div class="wrap">
    <% if (req.query.published === '1') { %>
      <div class="notice notice--ok" style="margin-bottom:20px">
        <strong class="notice__title">Published</strong>
        The event page is live and the hackathon appears in <a href="/hackathons">Explore hackathons</a>.
      </div>
    <% } %>
    <% if (req.query.posted === '1') { %><div class="notice notice--ok" style="margin-bottom:20px">Announcement posted.</div><% } %>
    <% if (req.query.added) { %><div class="notice notice--ok" style="margin-bottom:20px">Added <strong><%= req.query.added %></strong> as a participant.</div><% } %>

    <% if (nextAction) { %>
      <div class="next-step next-step--<%= nextAction.urgency %>">
        <div class="grow">
          <div class="next-step__label"><%= nextAction.urgency === 'blocking' ? 'Needs you' : 'Next step' %></div>
          <div class="next-step__title"><%= nextAction.label %></div>
          <div class="next-step__why"><%= nextAction.why %></div>
        </div>
        <div class="next-step__actions">
          <a class="btn btn--primary" href="<%= nextAction.href %>">Do it</a>
        </div>
      </div>
    <% } %>

    <div class="stat-row">
      <div class="stat">
        <div class="stat__n"><%= progress.submittedProjects %></div>
        <div class="stat__l">projects submitted of <%= counts.projects || 0 %></div>
      </div>
      <div class="stat">
        <div class="stat__n"><%= progress.activeJudges %><span class="tiny muted">/<%= progress.judges %></span></div>
        <div class="stat__l">judges accepted of <%= progress.judges %> invited</div>
      </div>
      <div class="stat">
        <div class="stat__n"><%= progress.submittedReviews %><span class="tiny muted">/<%= progress.assignments %></span></div>
        <div class="stat__l">reviews submitted</div>
      </div>
      <div class="stat <%= progress.coverage === 100 ? 'stat--ok' : (progress.submittedProjects ? 'stat--warn' : '') %>">
        <div class="stat__n"><%= progress.coverage %>%</div>
        <div class="stat__l">of submitted projects have a judge</div>
      </div>
      <div class="stat">
        <div class="stat__n" style="font-size:1.15rem"><%= h.fmt.rel(event.submission_deadline) %></div>
        <div class="stat__l">submissions close <%= h.fmt.date(event.submission_deadline) %></div>
      </div>
    </div>

    <% if (blockers.length && event.status === 'draft') { %>
      <div class="attention">
        <h3>Before you can publish</h3>
        <ul>
          <% blockers.forEach(b => { %>
            <li><a href="/host/events/<%= event.slug %>/setup/publish"><%= b %></a></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <% if (progress.attention.length) { %>
      <div class="attention">
        <h3>Needs attention</h3>
        <ul>
          <% progress.attention.forEach(a => { %><li><%= a.message %></li><% }) %>
        </ul>
        <div class="row row-wrap" style="margin-top:12px">
          <a class="btn btn--ghost btn--sm" href="/host/events/<%= event.slug %>/judging">Open judging</a>
          <a class="btn btn--ghost btn--sm" href="/host/events/<%= event.slug %>/assignments">Assignments</a>
        </div>
      </div>
    <% } %>

    <div class="ws">
      <div class="ws__main">
        <div class="card">
          <div class="card__head">
            <h2 class="card__title">Where the event is</h2>
            <a class="btn btn--ghost btn--sm" href="/host/events/<%= event.slug %>/settings">Settings</a>
          </div>
          <dl class="kv">
            <div><dt>Status</dt><dd><%= h.statusLabel(event.status) %></dd></div>
            <div><dt>Mode</dt><dd><%= event.mode === 'local' ? 'Local, self-hosted' : 'Global, public' %></dd></div>
            <div><dt>Registration</dt><dd><%= h.statusLabel(state.registration) %><%= event.registration_closes_at ? ' · closes ' + h.fmt.date(event.registration_closes_at) : '' %></dd></div>
            <div><dt>Submissions</dt><dd><%= state.submissions === 'open' ? 'Open until ' + h.fmt.dateTime(event.submission_deadline) : 'Closed ' + h.fmt.date(event.submission_deadline) %></dd></div>
            <div><dt>Judging</dt><dd><%= state.judging === 'open' ? 'Open' : state.judging === 'closed' ? 'Closed' : 'Not started' %></dd></div>
            <div><dt>Results</dt><dd><%= state.results === 'published' ? 'Published' : 'Not published' %></dd></div>
            <div><dt>Showcase</dt><dd><%= event.showcase_visibility === 'public' ? 'Public' : 'Private' %></dd></div>
          </dl>
          <div class="row row-wrap" style="margin-top:16px">
            <% if (event.status === 'draft') { %>
              <a class="btn btn--accent btn--sm" href="/host/events/<%= event.slug %>/setup/publish">Publish the hackathon</a>
            <% } else { %>
              <form method="post" action="/host/events/<%= event.slug %>/status">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--ghost btn--sm" type="submit">
                  <%= event.status === 'published' ? 'Mark as live' : event.status === 'live' ? 'Close submissions' : event.status === 'closed' ? 'Archive' : 'Archived' %>
                </button>
              </form>
              <% if (event.status !== 'archived') { %>
                <form method="post" action="/host/events/<%= event.slug %>/unpublish" data-confirm="Move the hackathon back to draft? It disappears from public discovery while registrations may be in progress.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn--quiet btn--sm" type="submit">Unpublish</button>
                </form>
              <% } %>
            <% } %>
          </div>
        </div>

        <div class="card" style="margin-top:20px">
          <div class="card__head">
            <h2 class="card__title">Recent activity</h2>
            <a class="btn btn--ghost btn--sm" href="/host/events/<%= event.slug %>/audit">Full audit log</a>
          </div>
          <% if (!announcements.length) { %>
            <p class="small muted">No announcements yet. Participants see them on the event page.</p>
          <% } else { %>
            <ul class="list-rows">
              <% announcements.forEach(a => { %>
                <li class="list-rows__item">
                  <div class="grow">
                    <span class="list-rows__title"><%= a.title %></span>
                    <span class="list-rows__meta"><%= a.body ? h.truncate(a.body, 90) : '' %></span>
                  </div>
                  <span class="tiny muted nowrap"><%= h.fmt.ago(a.created_at) %></span>
                  <form method="post" action="/host/events/<%= event.slug %>/announcements/<%= a.id %>/delete" data-confirm="Delete this announcement?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--quiet btn--sm" type="submit">Delete</button>
                  </form>
                </li>
              <% }) %>
            </ul>
          <% } %>
          <form method="post" action="/host/events/<%= event.slug %>/announcements" style="margin-top:16px">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label class="field__label" for="ann-title">Post an announcement</label>
              <input class="input" id="ann-title" name="title" placeholder="Judging opens tomorrow at 18:00 UTC" maxlength="140" required>
            </div>
            <div class="field">
              <label class="field__label" for="ann-body">Details</label>
              <textarea class="textarea" id="ann-body" name="body" maxlength="4000" style="min-height:80px" placeholder="Optional context for participants."></textarea>
            </div>
            <button class="btn btn--primary btn--sm" type="submit">Post announcement</button>
          </form>
        </div>
      </div>

      <aside class="ws__side">
        <div class="card">
          <h2 class="card__title" style="margin-bottom:10px">Quick actions</h2>
          <div class="stack" style="--gap:8px">
            <a class="btn btn--ghost btn--block" href="/host/events/<%= event.slug %>/judges">Invite judges</a>
            <a class="btn btn--ghost btn--block" href="/host/events/<%= event.slug %>/assignments">Assign projects</a>
            <a class="btn btn--ghost btn--block" href="/host/events/<%= event.slug %>/setup/judging">Edit the rubric</a>
            <a class="btn btn--ghost btn--block" href="/host/events/<%= event.slug %>/export">Export data</a>
          </div>
        </div>

        <div class="card">
          <h2 class="card__title" style="margin-bottom:10px">Latest teams</h2>
          <% if (!teams.length) { %>
            <p class="small muted">Nobody has created a team yet.</p>
          <% } else { %>
            <ul class="list-rows">
              <% teams.forEach(t => { %>
                <li class="list-rows__item">
                  <div class="grow">
                    <span class="list-rows__title"><%= t.name %></span>
                    <span class="list-rows__meta"><%= t.member_count %> <%= h.fmt.plural(t.member_count, 'member') %><%= t.project_title ? ' · ' + t.project_title : '' %></span>
                  </div>
                </li>
              <% }) %>
            </ul>
            <a class="btn btn--ghost btn--sm btn--block" style="margin-top:12px" href="/host/events/<%= event.slug %>/teams">All teams</a>
          <% } %>
        </div>

        <div class="card">
          <h2 class="card__title" style="margin-bottom:10px">Judging panel</h2>
          <% if (!progress.perJudge.length) { %>
            <p class="small muted">No judges yet. Invite one before submissions close so they can start on time.</p>
          <% } else { %>
            <ul class="list-rows">
              <% progress.perJudge.slice(0, 6).forEach(j => { %>
                <li class="list-rows__item">
                  <div class="grow">
                    <span class="list-rows__title"><%= j.name %></span>
                    <span class="list-rows__meta"><%= j.done %> of <%= j.assigned %> done · <%= j.status %></span>
                  </div>
                </li>
              <% }) %>
            </ul>
            <a class="btn btn--ghost btn--sm btn--block" style="margin-top:12px" href="/host/events/<%= event.slug %>/judging">Judging progress</a>
          <% } %>
        </div>
      </aside>
    </div>
  </div>
</section>
