<%
  const e = event;
  const s = state;
  const cover = e.cover_url && h.fmt.safe(e.cover_url)
    ? `<img src="${h.fmt.safe(e.cover_url)}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover">`
    : h.cover({ seed: e.slug, style: e.cover_style, accent: e.accent_color });
  const href = `/hackathons/${e.slug}`;
  const badge = s ? s.headline : h.statusLabel(e.status);
%>
<article class="event-card">
  <a class="event-card__cover" href="<%= href %>" aria-label="<%= e.name %>">
    <%- cover %>
    <span class="event-card__badge"><%= badge %></span>
  </a>
  <div class="event-card__body">
    <div class="event-card__meta">
      <span class="tag tag--outline"><%= h.formatLabel(e.format) %></span>
      <% if (e.mode === 'local') { %><span class="tag">Local</span><% } %>
      <% if (s && s.submissions === 'open' && s.canRegister) { %><span class="tag tag--ok"><span class="tag__dot"></span>Registration open</span><% } %>
    </div>
    <h3 class="event-card__title"><a href="<%= href %>"><%= e.name %></a></h3>
    <% if (e.tagline) { %><p class="event-card__tagline"><%= e.tagline %></p><% } %>
    <dl class="event-card__facts">
      <div>
        <dt>Prize pool</dt>
        <dd><%= h.fmt.prize(e.prize_pool_cents, e.prize_currency, e.prize_headline) %></dd>
      </div>
      <div>
        <dt>Dates</dt>
        <dd><%= h.fmt.range(e.starts_at, e.ends_at) %></dd>
      </div>
      <div>
        <dt>Submissions close</dt>
        <dd><%= e.submission_deadline ? h.fmt.date(e.submission_deadline) : 'Not set' %></dd>
      </div>
    </dl>
  </div>
  <div class="event-card__foot">
    <% if (counts) { %>
      <span class="small muted"><%= counts.projects %> <%= h.fmt.plural(counts.projects, 'project') %> · <%= counts.teams %> <%= h.fmt.plural(counts.teams, 'team') %></span>
    <% } else { %>
      <span class="small muted"><%= e.organizer_name || 'Independent organizers' %></span>
    <% } %>
    <span class="btn btn--ghost btn--sm">View hackathon</span>
  </div>
</article>
